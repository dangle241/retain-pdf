# Docker public version frontend runtime configuration
# FRONT_API_BASE usually left empty, frontend automatically uses same-origin proxy.
# Normal users do not need to see or fill API Base in the page.
FRONT_API_BASE=

# This must match one of the backend keys in docker/auth.local.json.
# Frontend automatically includes this backend authentication key.
FRONT_X_API_KEY=replace-with-your-backend-key

# Frontend default OCR provider.
# Current mainline default recommends paddle, can also change to mineru.
FRONT_OCR_PROVIDER=paddle

# Optional OCR / model default configuration.
# If you want end users to fill in OCR / model configuration in browser, keep empty.
FRONT_PADDLE_TOKEN=
FRONT_MINERU_TOKEN=
FRONT_MODEL_API_KEY=
FRONT_MODEL=deepseek-v4-flash
FRONT_BASE_URL=https://api.deepseek.com/v1
